# ============================================================
#  SECRETOS — nada de esto sale de este ordenador
# ============================================================
.env
.env.*
!.env.example
.vercel/

# ============================================================
#  EL PRODUCTO QUE SE VENDE
#  Los ZIP que api/download.js entrega contra una clave.
#
#  OJO: Vercel despliega CLONANDO ESTE REPOSITORIO. Lo que git no
#  tenga no llega al servidor, y api/download.js lee el zip del disco
#  (fs.readFile), asi que un zip ignorado = 500 despues de haber
#  cobrado. Por eso los dos zip EN USO si van versionados: ver la
#  excepcion al final de este fichero.
#
#  Esto solo es aceptable mientras el repositorio siga siendo PRIVADO.
#  Si algun dia se hace publico, Pro queda gratis para cualquiera: hay
#  que sacar los zip a un almacen aparte (Vercel Blob) ANTES de abrirlo.
# ============================================================
Ghosted-Landing/api/_private/*
dist/
*.zip

# ============================================================
#  PESO MUERTO
# ============================================================
node_modules/
# 28 MB de capturas para la tienda y redes; no las usa ninguna pagina
Ghosted-Landing/assets/shots-2026/
# copia del Plus viejo (26 de julio), guardada por si acaso
Ghosted-Plus.ANTES-20260906/
# historico del codigo ofuscado
codigo-ofuscado-anterior/

# ============================================================
#  GENERADO — nunca se edita a mano
#  Plus SE CONSTRUYE desde Pro con tools/construir-plus.js.
#  Versionarlo invitaria a editarlo directamente, que es justo
#  como se quedo atras en julio.
# ============================================================
Ghosted-Plus/

# ============================================================
#  SISTEMA
# ============================================================
.DS_Store
Thumbs.db
*.bak

# script que pide claves por teclado: no tiene secretos dentro, pero
# tampoco pinta en el repositorio
Ghosted-Landing/poner-claves.sh

# ============================================================
#  EXCEPCION, al final a proposito: en .gitignore gana la ultima
#  regla que encaja, y mas arriba hay un *.zip que taparia esto.
#  Solo los dos zip que nombra lib/downloads.js. Las versiones
#  viejas se borran al subir una nueva, que si no el repositorio
#  engorda medio mega por version.
# ============================================================
!Ghosted-Landing/api/_private/Ghoosted-Pro-v*.zip
!Ghosted-Landing/api/_private/Ghoosted-Plus-v*.zip
